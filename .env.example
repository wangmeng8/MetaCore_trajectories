# Required for real Tau2/OpenAI runs. Dry-run does not call the API.
OPENAI_API_KEY=sk-your-key-here

# Smoke-test defaults.
AGENT_MODEL=gpt-5.5
USER_MODEL=gpt-5.5
BENCHMARK=tau2-bench
TAU2_DOMAIN=airline
NUM_TASKS=2
NUM_TRIALS=1
OUTPUT_DIR=outputs/runs
# Set true to run all tasks in the selected Tau2 domain by omitting --num-tasks.
TAU2_ALL_TASKS=false
# Use a fixed run id together with TAU2_RESUME=true to collect into an existing run folder.
# TAU2_RUN_ID=tau2_airline_full
TAU2_RESUME=false
# Safer long-run mode: wrapper runs Tau2 task IDs as separate processes and checkpoints after each task.
TAU2_ONE_BY_ONE=false
# Optional explicit task IDs; supports comma or whitespace separators.
# TAU2_TASK_IDS=0 1 2
# Optional Tau2 task set/split overrides.
# TAU2_TASK_SET_NAME=airline
# TAU2_TASK_SPLIT_NAME=base
# Optional direct Tau2 save path under data/simulations for non-one-by-one runs.
# TAU2_SAVE_TO=metacore/tau2_airline_full
# Pass Tau2 --auto-resume when supported.
TAU2_AUTO_RESUME=false
# Normal mode: passed to Tau2 if the local CLI exposes a compatible worker flag.
# TAU2_ONE_BY_ONE=true: wrapper-level task concurrency, e.g. 8 starts tasks 1-8 first.
# TAU2_MAX_WORKERS=8
# Seconds between Tau2 wrapper progress updates.
TAU2_PROGRESS_INTERVAL=30

# Optional model/runtime settings. These are passed only if the local tau2 CLI supports them.
REASONING_EFFORT=medium
TEMPERATURE=0
# MAX_STEPS=20

# Override only if tau2 writes simulations somewhere else.
# TAU2_SIMULATIONS_DIR=data/simulations

# Use this on clusters where tau2 must be launched from a local checkout with uv.
# TAU2_REPO_DIR=.external/tau2-bench
# TAU2_COMMAND=uv run tau2
# TAU2_USE_UV=true

# Terminal-Bench 2.0 via Harbor.
TERMINAL_BENCH_DATASET=terminal-bench/terminal-bench-2
TERMINAL_BENCH_AGENT=terminus-2
HARBOR_JOBS_DIR=jobs
# TERMINAL_BENCH_TASK_NAME=openssl-selfsigned-cert
# HARBOR_ENV=daytona

# OSWorld-Verified via a local OSWorld checkout.
OSWORLD_REPO_DIR=.external/OSWorld
OSWORLD_PROVIDER_NAME=docker
OSWORLD_OBSERVATION_TYPE=screenshot
OSWORLD_CLIENT_PASSWORD=password
OSWORLD_HEADLESS=true
OSWORLD_SLEEP_AFTER_EXECUTION=3
# OSWORLD_DOMAIN=libreoffice_impress
# OSWORLD_EXAMPLE_ID=a669ef01-ded5-4099-9ea9-25e99b569840
# OSWORLD_PATH_TO_VM=Ubuntu/Ubuntu.vmx
# OSWORLD_USE_MULTIENV=false
# OSWORLD_NUM_ENVS=1

# Humanity's Last Exam with tools official Activeloop runner.
HLE_BENCHMARK=hle-with-tools
HLE_WITH_TOOLS_REPO_DIR=.external/hle_with_tools
HLE_DATASET=cais/hle
HLE_DATA_PATH=data/modelscope/cais_hle/data/test-00000-of-00001.parquet
HLE_WITH_TOOLS_TEXT_ONLY=true
HLE_ALL_TASKS=false
HLE_MAX_WORKERS=2
HLE_MAX_RETRIES=3
HLE_PROCESS_RETRIES=3
HLE_MAX_COMPLETION_TOKENS=40000
HLE_MAX_ITERATIONS=15
HLE_PROGRESS_INTERVAL=30
# Use a fixed run id to continue an interrupted official run.
# HLE_RUN_ID=hle_gpt55_full
# HLE with tools does not send temperature by default because some GPT-5.5 endpoints reject it.
# HLE_TEMPERATURE=0
# Required if the official scientific_search tool is used.
ACTIVELOOP_API_KEY=
ACTIVELOOP_WORKSPACE=default
ACTIVELOOP_BASE_URL=https://science-api.activeloop.ai
OPENAI_BASE_URL=https://api.openai.com/v1

# MetaCoreBench representation visualization wrapper.
# The wrapper writes a config for .external/MetaCoreBench-visualization and only runs it with --execute.
METACOREBENCH_MODEL_PATH=/data/oss_bucket_0/modelscope/hub/models/Qwen/Qwen3.6-27B
